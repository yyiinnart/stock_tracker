   Set Script Property SYNC_TOKEN to the 64-character code generated by the app.
   Never paste a real token into this source or commit it to GitHub. */
function reply_(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);}
function doGet(){return reply_({ok:true,service:'stock-tracker-drive',api:1});}
function doPost(e){
 try{
  const raw=e&&e.postData&&e.postData.contents;if(!raw||raw.length>4500000)throw Error('請求資料不正確或過大');
  const request=JSON.parse(raw),secret=PropertiesService.getScriptProperties().getProperty('SYNC_TOKEN');
  if(!secret||!/^[a-f0-9]{64}$/.test(secret)||request.token!==secret)throw Error('同步驗證碼不正確或服務尚未設定');
  if(request.method==='info')return reply_({ok:true,service:'stock-tracker-drive',api:1});
  if(!['readPortfolio','savePortfolio'].includes(request.method))throw Error('不支援的操作');
  if(request.method==='savePortfolio'){
   if(!Number.isInteger(request.revision)||request.revision<0||!request.payload||!Array.isArray(request.payload.live)||!Array.isArray(request.payload.audit))throw Error('同步資料格式不正確');
   if(JSON.stringify(request.payload).length>4000000)throw Error('資料超過同步容量，請先匯出並整理歷史快照');
  }
  const lock=LockService.getScriptLock();lock.waitLock(20000);
  try{
   const file=dataFile_(),text=file.getBlob().getDataAsString('UTF-8');
   const current=text?JSON.parse(text):{revision:0,payload:null,updatedAt:null};
   if(request.method==='readPortfolio')return reply_({ok:true,...current});
   if(current.revision!==request.revision)return reply_({ok:true,conflict:true,...current});
   const next={revision:current.revision+1,updatedAt:new Date().toISOString(),payload:request.payload};
   file.setContent(JSON.stringify(next));return reply_({ok:true,revision:next.revision,updatedAt:next.updatedAt});
  }finally{lock.releaseLock();}
 }catch(error){return reply_({ok:false,error:error.message||'同步服務發生錯誤'});}
}
function dataFile_(){
 const props=PropertiesService.getScriptProperties();const id=props.getProperty('SYNC_FILE_ID');
 if(id){const file=DriveApp.getFileById(id);if(file.isTrashed())throw Error('同步資料檔已移至垃圾桶，請先還原');return file;}
 let folder;const folderId=props.getProperty('SYNC_FOLDER_ID');
 if(folderId){folder=DriveApp.getFolderById(folderId);if(folder.isTrashed())throw Error('同步資料夾已移至垃圾桶，請先還原');}
 else{folder=DriveApp.createFolder('StockTracker Sync');props.setProperty('SYNC_FOLDER_ID',folder.getId());}
 const files=folder.getFilesByName('data.json');let file=files.hasNext()?files.next():folder.createFile('data.json',JSON.stringify({revision:0,payload:null,updatedAt:null}),MimeType.PLAIN_TEXT);
 props.setProperty('SYNC_FILE_ID',file.getId());return file;
}
